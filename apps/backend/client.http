# Variáveis de ambiente locais
@baseUrl = http://localhost:3000/


### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "uid": "caique",
    "password": "123456a"
}





### Register user
POST {{baseUrl}}/user/register
Content-Type: application/json

{
    "firstName": "Caique",
    "lastName": "Duarte",
    "password": "1234567a",
    "email": "email@email.com",
    "phone": "+55 (62) 33333-3333"
}


### Get user
GET {{baseUrl}}/user/0ba344b5-a639-43c8-92d1-f476397a0322


### Get all users
GET {{baseUrl}}/user/all


### Post condomínio
POST {{baseUrl}}/townhouse
Content-Type: application/json

{
  "name": "Corumbá 2"
}





### Get condomínio
GET {{baseUrl}}/townhouse


### Delete condomínio
DELETE {{baseUrl}}/townhouse/2


### Update condomínio
PATCH {{baseUrl}}/townhouse/3
Content-Type: application/json

{
    "name": "Corumbá 3"
}