NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
# Vazio em desenvolvimento; o padrão em produção é api (sem barras).
API_PREFIX=
# No Supabase, use a URI do Session pooler (porta 5432).
# DATABASE_URL tem prioridade sobre os campos separados abaixo.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=project_tangerine
DATABASE_SYNCHRONIZE=false
# TLS é habilitado por padrão em produção; localmente, o padrão é false.
# DATABASE_SSL=true
# CA PEM do painel Supabase, quando necessária. Aceita quebras de linha ou \n.
# DATABASE_SSL_CA=

JWT_SECRET=
# Em produção, use segredos aleatórios com pelo menos 32 caracteres.

# Opcionais; os valores abaixo já são os padrões.
# JWT_REFRESH_SECRET=
# JWT_AUDIENCE=project-tangerine-web
# JWT_ISSUER=project-tangerine-api
# JWT_TTL=900
# JWT_REFRESH_TTL=3600

# Necessárias somente ao executar npm run bootstrap:admin --workspace backend.
SYSTEM_ADMIN_FIRST_NAME=
SYSTEM_ADMIN_LAST_NAME=
SYSTEM_ADMIN_PHONE=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
